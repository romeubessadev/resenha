{
  "expo": {
    "name": "Resenha",
    "slug": "bros",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "resenha",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bros.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "pt_BR",
        "CFBundleLocalizations": [
          "pt-BR"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00A86B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bros.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para você escolher a foto da resenha na sua galeria.",
          "cameraPermission": "Para você tirar a foto da resenha na hora.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para ler o QR Code de uma resenha.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Para você lançar uma despesa falando."
        }
      ],
      "expo-font",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
